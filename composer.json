{
    "name": "betterworldcollective/canva-php-sdk",
    "description": "PHP SDK for integrating with Canva's API",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "saloonphp/saloon": "^4.0",
        "illuminate/collections": "^11.0.8 | ^12.7",
        "illuminate/support": "^11.0.8 | ^12.7",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.23",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Canva\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Canva\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "refactor": [
            "./vendor/bin/rector process"
        ],
        "format": [
            "./vendor/bin/pint --dirty"
        ],
        "format:test": [
            "./vendor/bin/pint --dirty --test -v"
        ],
        "analyse": [
            "./vendor/bin/phpstan analyse --memory-limit=-1"
        ],
        "test": [
            "./vendor/bin/pest tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
